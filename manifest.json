{
  "manifest_version": 3,
  "name": "Sora Text Batch Runner",
  "version": "1.0.0",
  "description": "Chạy prompt Sora hàng loạt trong Flow và hỗ trợ tải video.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [],
  "host_permissions": [
    "https://sora.chatgpt.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://sora.chatgpt.com/*"],
      "js": ["sora.js"],
      "run_at": "document_idle"
    }
  ]
}
